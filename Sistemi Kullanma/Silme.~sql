SELECT
    L.LIG_ID,
    L.LIG_ADI,

    (
        SELECT COUNT(*)
        FROM DE_TAKIMLAR T
        WHERE T.LIG_ID = L.LIG_ID
    ) AS TAKIM_SAYISI,

    (
        SELECT COUNT(*)
        FROM DE_FIKSTUR F
        WHERE F.LIG_ID = L.LIG_ID
    ) AS FIKSTUR_SAYISI,

    (
        SELECT COUNT(DISTINCT HAFTA)
        FROM DE_FIKSTUR F
        WHERE F.LIG_ID = L.LIG_ID
    ) AS HAFTA_SAYISI

FROM DE_LIGLER L
ORDER BY L.LIG_ID;
