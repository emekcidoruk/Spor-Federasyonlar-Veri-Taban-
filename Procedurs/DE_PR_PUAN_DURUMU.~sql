CREATE OR REPLACE PROCEDURE DE_PUAN_DURUMU_HESAPLA (
    P_LIG_ID IN NUMBER
)
AS

    V_FED_ID NUMBER;

    V_OYNANAN NUMBER;

    V_G NUMBER;
    V_B NUMBER;
    V_M NUMBER;

    V_ATILAN NUMBER;
    V_YENILEN NUMBER;

    V_PUAN NUMBER;

    V_SET_ORANI NUMBER;

    V_ALINAN_SAYI NUMBER;
    V_VERILEN_SAYI NUMBER;

    V_SAYI_ORANI NUMBER;


BEGIN

    SELECT FEDERASYON_ID
    INTO V_FED_ID

    FROM DE_LIGLER

    WHERE LIG_ID =
          P_LIG_ID;



    /* =====================================================
       LIGDEKI TAKIMLAR
       ===================================================== */

    FOR T IN (

        SELECT TAKIM_ID

        FROM DE_TAKIMLAR

        WHERE LIG_ID =
              P_LIG_ID

        ORDER BY TAKIM_ID

    )
    LOOP


        /* =================================================
           FUTBOL
           ================================================= */

        IF V_FED_ID = 1 THEN


            SELECT

                NVL(SUM(
                    CASE
                        WHEN ATILAN > YENILEN
                            THEN 1
                        ELSE 0
                    END
                ),0),

                NVL(SUM(
                    CASE
                        WHEN ATILAN = YENILEN
                            THEN 1
                        ELSE 0
                    END
                ),0),

                NVL(SUM(
                    CASE
                        WHEN ATILAN < YENILEN
                            THEN 1
                        ELSE 0
                    END
                ),0),

                NVL(SUM(ATILAN),0),

                NVL(SUM(YENILEN),0)

            INTO
                V_G,
                V_B,
                V_M,
                V_ATILAN,
                V_YENILEN

            FROM (

                SELECT

                    TO_NUMBER(
                        REGEXP_SUBSTR(
                            MAC_SONUCU,
                            '^[0-9]+'
                        )
                    ) ATILAN,

                    TO_NUMBER(
                        REGEXP_SUBSTR(
                            MAC_SONUCU,
                            '[0-9]+$'
                        )
                    ) YENILEN

                FROM DE_FIKSTUR

                WHERE LIG_ID =
                      P_LIG_ID

                  AND EV_SAHIBI_TAKIM_ID =
                      T.TAKIM_ID

                  AND MAC_SONUCU <>
                      'OYNANMADI'


                UNION ALL


                SELECT

                    TO_NUMBER(
                        REGEXP_SUBSTR(
                            MAC_SONUCU,
                            '[0-9]+$'
                        )
                    ),

                    TO_NUMBER(
                        REGEXP_SUBSTR(
                            MAC_SONUCU,
                            '^[0-9]+'
                        )
                    )

                FROM DE_FIKSTUR

                WHERE LIG_ID =
                      P_LIG_ID

                  AND DEPLASMAN_TAKIM_ID =
                      T.TAKIM_ID

                  AND MAC_SONUCU <>
                      'OYNANMADI'

            );


            V_PUAN :=
                (V_G * 3) +
                V_B;



            MERGE INTO DE_FUTBOL_PUAN_DURUMU P

            USING (

                SELECT
                    P_LIG_ID LIG_ID,
                    T.TAKIM_ID TAKIM_ID

                FROM DUAL

            ) X

            ON (
                P.LIG_ID = X.LIG_ID
                AND
                P.TAKIM_ID = X.TAKIM_ID
            )

            WHEN MATCHED THEN

                UPDATE SET

                    P.GALIBIYET =
                        V_G,

                    P.BERABERLIK =
                        V_B,

                    P.MAGLUBIYET =
                        V_M,

                    P.ATILAN_GOL =
                        V_ATILAN,

                    P.YENILEN_GOL =
                        V_YENILEN,

                    P.PUAN =
                        V_PUAN,

                    P.ISLEM_TARIHI =
                        SYSDATE


            WHEN NOT MATCHED THEN

                INSERT (

                    LIG_ID,
                    TAKIM_ID,

                    GALIBIYET,
                    BERABERLIK,
                    MAGLUBIYET,

                    ATILAN_GOL,
                    YENILEN_GOL,

                    PUAN,

                    ISLEM_TARIHI

                )
                VALUES (

                    P_LIG_ID,
                    T.TAKIM_ID,

                    V_G,
                    V_B,
                    V_M,

                    V_ATILAN,
                    V_YENILEN,

                    V_PUAN,

                    SYSDATE
                );



        /* =================================================
           BASKETBOL
           ================================================= */

        ELSIF V_FED_ID = 2 THEN


            SELECT

                COUNT(*),

                NVL(SUM(
                    CASE
                        WHEN ATILAN > YENILEN
                            THEN 1
                        ELSE 0
                    END
                ),0),

                NVL(SUM(
                    CASE
                        WHEN ATILAN < YENILEN
                            THEN 1
                        ELSE 0
                    END
                ),0),

                NVL(SUM(ATILAN),0),

                NVL(SUM(YENILEN),0)

            INTO
                V_OYNANAN,
                V_G,
                V_M,
                V_ATILAN,
                V_YENILEN

            FROM (

                SELECT

                    TO_NUMBER(
                        REGEXP_SUBSTR(
                            MAC_SONUCU,
                            '^[0-9]+'
                        )
                    ) ATILAN,

                    TO_NUMBER(
                        REGEXP_SUBSTR(
                            MAC_SONUCU,
                            '[0-9]+$'
                        )
                    ) YENILEN

                FROM DE_FIKSTUR

                WHERE LIG_ID =
                      P_LIG_ID

                  AND EV_SAHIBI_TAKIM_ID =
                      T.TAKIM_ID

                  AND MAC_SONUCU <>
                      'OYNANMADI'


                UNION ALL


                SELECT

                    TO_NUMBER(
                        REGEXP_SUBSTR(
                            MAC_SONUCU,
                            '[0-9]+$'
                        )
                    ),

                    TO_NUMBER(
                        REGEXP_SUBSTR(
                            MAC_SONUCU,
                            '^[0-9]+'
                        )
                    )

                FROM DE_FIKSTUR

                WHERE LIG_ID =
                      P_LIG_ID

                  AND DEPLASMAN_TAKIM_ID =
                      T.TAKIM_ID

                  AND MAC_SONUCU <>
                      'OYNANMADI'

            );


            V_PUAN :=
                (V_G * 2) +
                V_M;



            MERGE INTO DE_BASKETBOL_PUAN_DURUMU P

            USING (

                SELECT
                    P_LIG_ID LIG_ID,
                    T.TAKIM_ID TAKIM_ID

                FROM DUAL

            ) X

            ON (
                P.LIG_ID = X.LIG_ID
                AND
                P.TAKIM_ID = X.TAKIM_ID
            )

            WHEN MATCHED THEN

                UPDATE SET

                    P.OYNANAN_MAC =
                        V_OYNANAN,

                    P.GALIBIYET =
                        V_G,

                    P.MAGLUBIYET =
                        V_M,

                    P.ATILAN_SAYI =
                        V_ATILAN,

                    P.YENILEN_SAYI =
                        V_YENILEN,

                    P.IC_AVERAJ = 0,

                    P.IC_PUAN = 0,

                    P.TOPLAM_AVERAJ =
                        V_ATILAN -
                        V_YENILEN,

                    P.PUAN =
                        V_PUAN,

                    P.ISLEM_TARIHI =
                        SYSDATE


            WHEN NOT MATCHED THEN

                INSERT (

                    LIG_ID,
                    TAKIM_ID,

                    OYNANAN_MAC,
                    GALIBIYET,
                    MAGLUBIYET,

                    ATILAN_SAYI,
                    YENILEN_SAYI,

                    IC_AVERAJ,
                    IC_PUAN,

                    TOPLAM_AVERAJ,

                    PUAN,

                    ISLEM_TARIHI

                )
                VALUES (

                    P_LIG_ID,
                    T.TAKIM_ID,

                    V_OYNANAN,
                    V_G,
                    V_M,

                    V_ATILAN,
                    V_YENILEN,

                    0,
                    0,

                    V_ATILAN -
                    V_YENILEN,

                    V_PUAN,

                    SYSDATE
                );



        /* =================================================
           VOLEYBOL
           ================================================= */

        ELSIF V_FED_ID = 3 THEN


            SELECT

                COUNT(*),

                NVL(SUM(
                    CASE
                        WHEN ATILAN = 3
                            THEN 1
                        ELSE 0
                    END
                ),0),

                NVL(SUM(
                    CASE
                        WHEN YENILEN = 3
                            THEN 1
                        ELSE 0
                    END
                ),0),

                NVL(SUM(ATILAN),0),

                NVL(SUM(YENILEN),0),

                NVL(SUM(
                    CASE

                        WHEN ATILAN = 3
                             AND YENILEN IN (0,1)
                            THEN 3

                        WHEN ATILAN = 3
                             AND YENILEN = 2
                            THEN 2

                        WHEN ATILAN = 2
                             AND YENILEN = 3
                            THEN 1

                        ELSE 0

                    END
                ),0)

            INTO
                V_OYNANAN,
                V_G,
                V_M,
                V_ATILAN,
                V_YENILEN,
                V_PUAN

            FROM (

                SELECT

                    TO_NUMBER(
                        REGEXP_SUBSTR(
                            MAC_SONUCU,
                            '^[0-9]+'
                        )
                    ) ATILAN,

                    TO_NUMBER(
                        REGEXP_SUBSTR(
                            MAC_SONUCU,
                            '[0-9]+$'
                        )
                    ) YENILEN

                FROM DE_FIKSTUR

                WHERE LIG_ID =
                      P_LIG_ID

                  AND EV_SAHIBI_TAKIM_ID =
                      T.TAKIM_ID

                  AND MAC_SONUCU <>
                      'OYNANMADI'


                UNION ALL


                SELECT

                    TO_NUMBER(
                        REGEXP_SUBSTR(
                            MAC_SONUCU,
                            '[0-9]+$'
                        )
                    ),

                    TO_NUMBER(
                        REGEXP_SUBSTR(
                            MAC_SONUCU,
                            '^[0-9]+'
                        )
                    )

                FROM DE_FIKSTUR

                WHERE LIG_ID =
                      P_LIG_ID

                  AND DEPLASMAN_TAKIM_ID =
                      T.TAKIM_ID

                  AND MAC_SONUCU <>
                      'OYNANMADI'

            );



            /* Set oraný */

            IF V_YENILEN = 0 THEN

                V_SET_ORANI :=
                    V_ATILAN;

            ELSE

                V_SET_ORANI :=
                    ROUND(
                        V_ATILAN /
                        V_YENILEN,
                        3
                    );

            END IF;



            /* Gerçek voleybol sayý toplamlarý skor logdan */

            SELECT

                NVL(SUM(
                    CASE
                        WHEN SL.TAKIM_ID =
                             T.TAKIM_ID
                            THEN SL.SKOR_DEGERI
                        ELSE 0
                    END
                ),0),

                NVL(SUM(
                    CASE
                        WHEN SL.TAKIM_ID <>
                             T.TAKIM_ID
                            THEN SL.SKOR_DEGERI
                        ELSE 0
                    END
                ),0)

            INTO
                V_ALINAN_SAYI,
                V_VERILEN_SAYI

            FROM DE_SKOR_LOG SL

            JOIN DE_FIKSTUR F
                ON F.FIKSTUR_ID =
                   SL.FIKSTUR_ID

            WHERE F.LIG_ID =
                  P_LIG_ID

              AND (
                    F.EV_SAHIBI_TAKIM_ID =
                    T.TAKIM_ID

                    OR

                    F.DEPLASMAN_TAKIM_ID =
                    T.TAKIM_ID
                  )

              AND SL.SKOR_TURU =
                  'SET_PUANI';



            IF V_VERILEN_SAYI = 0 THEN

                V_SAYI_ORANI :=
                    V_ALINAN_SAYI;

            ELSE

                V_SAYI_ORANI :=
                    ROUND(
                        V_ALINAN_SAYI /
                        V_VERILEN_SAYI,
                        3
                    );

            END IF;



            MERGE INTO DE_VOLEYBOL_PUAN_DURUMU P

            USING (

                SELECT
                    P_LIG_ID LIG_ID,
                    T.TAKIM_ID TAKIM_ID

                FROM DUAL

            ) X

            ON (
                P.LIG_ID = X.LIG_ID
                AND
                P.TAKIM_ID = X.TAKIM_ID
            )

            WHEN MATCHED THEN

                UPDATE SET

                    P.OYNANAN_MAC =
                        V_OYNANAN,

                    P.GALIBIYET =
                        V_G,

                    P.MAGLUBIYET =
                        V_M,

                    P.ALINAN_SET =
                        V_ATILAN,

                    P.VERILEN_SET =
                        V_YENILEN,

                    P.SET_ORANI =
                        V_SET_ORANI,

                    P.ALINAN_SAYI_PUANI =
                        V_ALINAN_SAYI,

                    P.VERILEN_SAYI_PUANI =
                        V_VERILEN_SAYI,

                    P.SAYI_PUANI_ORANI =
                        V_SAYI_ORANI,

                    P.PUAN =
                        V_PUAN,

                    P.ISLEM_TARIHI =
                        SYSDATE


            WHEN NOT MATCHED THEN

                INSERT (

                    LIG_ID,
                    TAKIM_ID,

                    OYNANAN_MAC,
                    GALIBIYET,
                    MAGLUBIYET,

                    ALINAN_SET,
                    VERILEN_SET,

                    SET_ORANI,

                    ALINAN_SAYI_PUANI,
                    VERILEN_SAYI_PUANI,

                    SAYI_PUANI_ORANI,

                    PUAN,

                    ISLEM_TARIHI

                )
                VALUES (

                    P_LIG_ID,
                    T.TAKIM_ID,

                    V_OYNANAN,
                    V_G,
                    V_M,

                    V_ATILAN,
                    V_YENILEN,

                    V_SET_ORANI,

                    V_ALINAN_SAYI,
                    V_VERILEN_SAYI,

                    V_SAYI_ORANI,

                    V_PUAN,

                    SYSDATE
                );


        END IF;


    END LOOP;


END DE_PUAN_DURUMU_HESAPLA;
/
