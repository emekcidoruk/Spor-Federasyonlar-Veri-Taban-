CREATE OR REPLACE PROCEDURE DE_SKOR_LOG_YENIDEN_OLUSTUR (
    P_FIKSTUR_ID IN NUMBER
)
AS

    V_FED_ID NUMBER;

    V_EV_ID NUMBER;
    V_DEP_ID NUMBER;

    V_EV_SKOR NUMBER;
    V_DEP_SKOR NUMBER;

    V_MAC_TARIHI DATE;

    V_MAC_SONUCU VARCHAR2(50);

    V_OYUNCU NUMBER;

    V_KALAN NUMBER;
    V_DEGER NUMBER;

    V_TOPLAM_SET NUMBER;

    V_SET_KAZANAN NUMBER;
    V_SET_KAYBEDEN NUMBER;

    V_KAZANAN_PUAN NUMBER;
    V_KAYBEDEN_PUAN NUMBER;


    FUNCTION OYUNCU_GETIR (
        P_TAKIM_ID NUMBER
    )
    RETURN NUMBER
    AS

        V_OYUNCU_ID NUMBER;

    BEGIN

        SELECT OYUNCU_LISANS_NO
        INTO V_OYUNCU_ID

        FROM (

            SELECT OYUNCU_LISANS_NO

            FROM DE_OYUNCULAR

            WHERE TAKIM_ID =
                  P_TAKIM_ID

            ORDER BY DBMS_RANDOM.VALUE

        )

        WHERE ROWNUM = 1;


        RETURN V_OYUNCU_ID;

    EXCEPTION

        WHEN NO_DATA_FOUND THEN

            RAISE_APPLICATION_ERROR(
                -20200,
                'TAKIM_ID=' || P_TAKIM_ID ||
                ' icin oyuncu bulunamadi.'
            );

    END;


BEGIN

    SELECT
        FEDERASYON_ID,
        EV_SAHIBI_TAKIM_ID,
        DEPLASMAN_TAKIM_ID,
        MAC_TARIHI,
        MAC_SONUCU

    INTO
        V_FED_ID,
        V_EV_ID,
        V_DEP_ID,
        V_MAC_TARIHI,
        V_MAC_SONUCU

    FROM DE_FIKSTUR

    WHERE FIKSTUR_ID =
          P_FIKSTUR_ID;


    IF UPPER(TRIM(V_MAC_SONUCU))
       = 'OYNANMADI'
    THEN
        RETURN;
    END IF;


    V_EV_SKOR :=
        TO_NUMBER(
            REGEXP_SUBSTR(
                V_MAC_SONUCU,
                '^[0-9]+'
            )
        );


    V_DEP_SKOR :=
        TO_NUMBER(
            REGEXP_SUBSTR(
                V_MAC_SONUCU,
                '[0-9]+$'
            )
        );


    /* Sonuç düzeltilirse eski skor loglarýný sil */

    DELETE FROM DE_SKOR_LOG
    WHERE FIKSTUR_ID =
          P_FIKSTUR_ID;



    /* =====================================================
       FUTBOL
       ===================================================== */

    IF V_FED_ID = 1 THEN


        IF V_EV_SKOR > 0 THEN

            FOR I IN 1..V_EV_SKOR LOOP

                V_OYUNCU :=
                    OYUNCU_GETIR(V_EV_ID);


                INSERT INTO DE_SKOR_LOG (

                    FEDERASYON_ID,
                    FIKSTUR_ID,
                    MAC_TARIHI,

                    OYUNCU_LISANS_NO,
                    TAKIM_ID,

                    SKOR_TURU,
                    SKOR_DEGERI,

                    DAKIKA,
                    PERIYOT_SET

                )
                VALUES (

                    V_FED_ID,
                    P_FIKSTUR_ID,
                    V_MAC_TARIHI,

                    V_OYUNCU,
                    V_EV_ID,

                    'GOL',
                    1,

                    TRUNC(
                        DBMS_RANDOM.VALUE(1,91)
                    ),

                    NULL
                );

            END LOOP;

        END IF;


        IF V_DEP_SKOR > 0 THEN

            FOR I IN 1..V_DEP_SKOR LOOP

                V_OYUNCU :=
                    OYUNCU_GETIR(V_DEP_ID);


                INSERT INTO DE_SKOR_LOG (

                    FEDERASYON_ID,
                    FIKSTUR_ID,
                    MAC_TARIHI,

                    OYUNCU_LISANS_NO,
                    TAKIM_ID,

                    SKOR_TURU,
                    SKOR_DEGERI,

                    DAKIKA,
                    PERIYOT_SET

                )
                VALUES (

                    V_FED_ID,
                    P_FIKSTUR_ID,
                    V_MAC_TARIHI,

                    V_OYUNCU,
                    V_DEP_ID,

                    'GOL',
                    1,

                    TRUNC(
                        DBMS_RANDOM.VALUE(1,91)
                    ),

                    NULL
                );

            END LOOP;

        END IF;



    /* =====================================================
       BASKETBOL
       ===================================================== */

    ELSIF V_FED_ID = 2 THEN


        /* EV */

        V_KALAN :=
            V_EV_SKOR;


        WHILE V_KALAN > 0 LOOP


            IF V_KALAN = 1 THEN
                V_DEGER := 1;

            ELSIF V_KALAN = 2 THEN
                V_DEGER := 2;

            ELSE

                V_DEGER :=
                    TRUNC(
                        DBMS_RANDOM.VALUE(1,4)
                    );

                IF V_DEGER > V_KALAN THEN
                    V_DEGER := 1;
                END IF;

            END IF;


            V_OYUNCU :=
                OYUNCU_GETIR(V_EV_ID);


            INSERT INTO DE_SKOR_LOG (

                FEDERASYON_ID,
                FIKSTUR_ID,
                MAC_TARIHI,

                OYUNCU_LISANS_NO,
                TAKIM_ID,

                SKOR_TURU,
                SKOR_DEGERI,

                DAKIKA,
                PERIYOT_SET

            )
            VALUES (

                V_FED_ID,
                P_FIKSTUR_ID,
                V_MAC_TARIHI,

                V_OYUNCU,
                V_EV_ID,

                CASE V_DEGER
                    WHEN 3 THEN '3 SAYI'
                    WHEN 2 THEN '2 SAYI'
                    ELSE 'SERBEST ATIS'
                END,

                V_DEGER,

                TRUNC(
                    DBMS_RANDOM.VALUE(1,11)
                ),

                TRUNC(
                    DBMS_RANDOM.VALUE(1,5)
                )

            );


            V_KALAN :=
                V_KALAN -
                V_DEGER;

        END LOOP;



        /* DEPLASMAN */

        V_KALAN :=
            V_DEP_SKOR;


        WHILE V_KALAN > 0 LOOP


            IF V_KALAN = 1 THEN
                V_DEGER := 1;

            ELSIF V_KALAN = 2 THEN
                V_DEGER := 2;

            ELSE

                V_DEGER :=
                    TRUNC(
                        DBMS_RANDOM.VALUE(1,4)
                    );

                IF V_DEGER > V_KALAN THEN
                    V_DEGER := 1;
                END IF;

            END IF;


            V_OYUNCU :=
                OYUNCU_GETIR(V_DEP_ID);


            INSERT INTO DE_SKOR_LOG (

                FEDERASYON_ID,
                FIKSTUR_ID,
                MAC_TARIHI,

                OYUNCU_LISANS_NO,
                TAKIM_ID,

                SKOR_TURU,
                SKOR_DEGERI,

                DAKIKA,
                PERIYOT_SET

            )
            VALUES (

                V_FED_ID,
                P_FIKSTUR_ID,
                V_MAC_TARIHI,

                V_OYUNCU,
                V_DEP_ID,

                CASE V_DEGER
                    WHEN 3 THEN '3 SAYI'
                    WHEN 2 THEN '2 SAYI'
                    ELSE 'SERBEST ATIS'
                END,

                V_DEGER,

                TRUNC(
                    DBMS_RANDOM.VALUE(1,11)
                ),

                TRUNC(
                    DBMS_RANDOM.VALUE(1,5)
                )

            );


            V_KALAN :=
                V_KALAN -
                V_DEGER;

        END LOOP;



    /* =====================================================
       VOLEYBOL
       ===================================================== */

    ELSIF V_FED_ID = 3 THEN


        V_TOPLAM_SET :=
            V_EV_SKOR +
            V_DEP_SKOR;


        FOR S IN 1..V_TOPLAM_SET LOOP


            /* Set kazananýný final skora uygun oluþtur */

            IF V_EV_SKOR = 3 THEN


                IF V_DEP_SKOR = 0 THEN

                    V_SET_KAZANAN :=
                        V_EV_ID;


                ELSIF V_DEP_SKOR = 1 THEN

                    IF S = 2 THEN
                        V_SET_KAZANAN := V_DEP_ID;
                    ELSE
                        V_SET_KAZANAN := V_EV_ID;
                    END IF;


                ELSE

                    /* 3-2 */

                    IF S IN (2,4) THEN
                        V_SET_KAZANAN := V_DEP_ID;
                    ELSE
                        V_SET_KAZANAN := V_EV_ID;
                    END IF;

                END IF;


            ELSE


                IF V_EV_SKOR = 0 THEN

                    V_SET_KAZANAN :=
                        V_DEP_ID;


                ELSIF V_EV_SKOR = 1 THEN

                    IF S = 2 THEN
                        V_SET_KAZANAN := V_EV_ID;
                    ELSE
                        V_SET_KAZANAN := V_DEP_ID;
                    END IF;


                ELSE

                    /* 2-3 */

                    IF S IN (2,4) THEN
                        V_SET_KAZANAN := V_EV_ID;
                    ELSE
                        V_SET_KAZANAN := V_DEP_ID;
                    END IF;

                END IF;


            END IF;


            IF V_SET_KAZANAN =
               V_EV_ID
            THEN

                V_SET_KAYBEDEN :=
                    V_DEP_ID;

            ELSE

                V_SET_KAYBEDEN :=
                    V_EV_ID;

            END IF;



            IF S = 5 THEN

                V_KAZANAN_PUAN := 15;

                V_KAYBEDEN_PUAN :=
                    TRUNC(
                        DBMS_RANDOM.VALUE(7,14)
                    );

            ELSE

                V_KAZANAN_PUAN := 25;

                V_KAYBEDEN_PUAN :=
                    TRUNC(
                        DBMS_RANDOM.VALUE(15,24)
                    );

            END IF;



            /* Kazanan takýmýn set puaný */

            V_OYUNCU :=
                OYUNCU_GETIR(
                    V_SET_KAZANAN
                );


            INSERT INTO DE_SKOR_LOG (

                FEDERASYON_ID,
                FIKSTUR_ID,
                MAC_TARIHI,

                OYUNCU_LISANS_NO,
                TAKIM_ID,

                SKOR_TURU,
                SKOR_DEGERI,

                DAKIKA,
                PERIYOT_SET

            )
            VALUES (

                3,
                P_FIKSTUR_ID,
                V_MAC_TARIHI,

                V_OYUNCU,
                V_SET_KAZANAN,

                'SET_PUANI',
                V_KAZANAN_PUAN,

                NULL,
                S

            );


            /* Kaybeden takým */

            V_OYUNCU :=
                OYUNCU_GETIR(
                    V_SET_KAYBEDEN
                );


            INSERT INTO DE_SKOR_LOG (

                FEDERASYON_ID,
                FIKSTUR_ID,
                MAC_TARIHI,

                OYUNCU_LISANS_NO,
                TAKIM_ID,

                SKOR_TURU,
                SKOR_DEGERI,

                DAKIKA,
                PERIYOT_SET

            )
            VALUES (

                3,
                P_FIKSTUR_ID,
                V_MAC_TARIHI,

                V_OYUNCU,
                V_SET_KAYBEDEN,

                'SET_PUANI',
                V_KAYBEDEN_PUAN,

                NULL,
                S

            );


        END LOOP;


    END IF;


END DE_SKOR_LOG_YENIDEN_OLUSTUR;
/
